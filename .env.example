# PostgreSQL
POSTGRES_DB=eventhub
POSTGRES_USER=eventhub
POSTGRES_PASSWORD=eventhub
POSTGRES_PORT=5432

# Application
APP_PORT=8080
SERVER_PORT=8080

# Spring DataSource (used when running locally outside Docker)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/eventhub
SPRING_DATASOURCE_USERNAME=eventhub
SPRING_DATASOURCE_PASSWORD=eventhub

# JWT
JWT_SECRET=change-me-use-a-long-secret-key-for-development-only-256bits
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_CAPACITY=10
RATE_LIMIT_AUTH_REFILL_MINUTES=1
RATE_LIMIT_REGISTRATION_CAPACITY=30
RATE_LIMIT_REGISTRATION_REFILL_MINUTES=1
RATE_LIMIT_REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379

# Admin bootstrap (Docker profile creates admin@eventhub.local by default)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=EventHub Admin

# Tracing (enabled in Docker profile)
OTEL_EXPORTER_OTLP_ENDPOINT=
TRACING_SAMPLING_PROBABILITY=0.0

# Observability stack (Docker Compose)
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090

# Email (MailHog in Docker Compose)
MAIL_ENABLED=true
MAIL_FROM=noreply@eventhub.local
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# PostgreSQL
POSTGRES_DB=eventhub
POSTGRES_USER=eventhub
POSTGRES_PASSWORD=eventhub
POSTGRES_PORT=5432

# Application
APP_PORT=8080
SERVER_PORT=8080

# Spring DataSource (used when running locally outside Docker)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/eventhub
SPRING_DATASOURCE_USERNAME=eventhub
SPRING_DATASOURCE_PASSWORD=eventhub

# JWT
JWT_SECRET=change-me-use-a-long-secret-key-for-development-only-256bits
JWT_EXPIRATION_MS=86400000
